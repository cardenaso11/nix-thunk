packages: .

-- GHC 9.14 ships base 4.22 and template-haskell 2.24, which most of the
-- dependency tree still caps below. The upper bounds keep the relaxation from
-- reaching past 9.14 itself.
if impl(ghc == 9.14.*)
  allow-newer:
      *:base
    , *:template-haskell
    , *:ghc-experimental
    , *:ghc-internal
    , patch:containers
    , parser-regex:ghc-bignum
  constraints:
      base < 4.23
    , template-haskell < 2.25
    , ghc-experimental < 9.1500
    , ghc-internal < 9.1500
